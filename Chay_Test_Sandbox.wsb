<Configuration>
  <MappedFolders>
    <!-- 1. Ánh xạ toàn bộ Python 3.12 và thư viện pip từ máy thật -->
    <MappedFolder>
      <HostFolder>C:\Users\toneb\AppData\Local\Programs\Python\Python312</HostFolder>
      <SandboxFolder>C:\Python312</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <!-- 2. Ánh xạ bộ Playwright Chromium cào bài có sẵn (không cần tải lại) -->
    <MappedFolder>
      <HostFolder>C:\Users\toneb\AppData\Local\ms-playwright</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\AppData\Local\ms-playwright</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <!-- 3. Ánh xạ thư mục Tool lên Desktop Sandbox -->
    <MappedFolder>
      <HostFolder>C:\Users\toneb\Downloads\Facebook_Traffic_Master_TM</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\Facebook_Traffic_Master_TM</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -Command "[System.Environment]::SetEnvironmentVariable('PATH', $env:PATH + ';C:\Python312;C:\Python312\Scripts', 'Machine')"</Command>
  </LogonCommand>
</Configuration>